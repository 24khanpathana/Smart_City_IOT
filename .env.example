# Copy to .env and edit. Placeholders only - never commit real credentials.
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=smart_city
# Leave empty for a local single-node Cassandra without authentication
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=

SPARK_MASTER=local[*]
SPARK_CONNECTOR_PACKAGE=com.datastax.spark:spark-cassandra-connector_2.12:3.5.1

# Sensor health rules (minutes since last reading)
SENSOR_ACTIVE_MINUTES=30
SENSOR_INACTIVE_MINUTES=180
# "data" = compare against newest reading in the dataset (right for synthetic/historic data)
# "now"  = compare against the current clock (right for live ingestion)
HEALTH_REFERENCE=data

# Analytics thresholds
ZSCORE_THRESHOLD=3.0
MIN_OBSERVATIONS=30
WASTE_WARNING_PCT=80
WASTE_CRITICAL_PCT=90
PARKING_HIGH_DEMAND_PCT=80
TRAFFIC_SURGE_PCT=150
MAX_RESULT_ROWS=5000
